# karotten — local standalone config.
# Copy to `.env` (gitignored) and fill in values, then run via run-local.sh.

# AMQP URL: amqp://<user>:<password>@<host>:<port>/<vhost>
# For looky dev (rabbit container exposed on host port 5672, vhost `default`):
#   RABBITMQ_URL=amqp://looky_logs:<password>@localhost:5672/default
RABBITMQ_URL=

# Topic exchange to publish into. Must already exist on the broker.
EXCHANGE=containers-logs

# Docker engine socket. On Linux: /var/run/docker.sock.
# On macOS with Docker Desktop, the user-level socket is at
# $HOME/.docker/run/docker.sock — adjust if you use a different
# context / colima / orbstack / etc.
DOCKER_SOCK=

# Set to any non-empty value for verbose per-message logs. Off by default.
# DEBUG=1
